{
  "openapi": "3.1.0",
  "info": {
    "title": "Petstore",
    "summary": "Pets, in 3.1",
    "version": "1.0.0",
    "license": {
      "name": "Apache 2.0",
      "identifier": "Apache-2.0"
    }
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "responses": {
          "200": {
            "description": "A list of pets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pet"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
